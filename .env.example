# IPAWS feed configuration
# Use staging for development/testing, production for live alerts.
IPAWS_ENVIRONMENT=staging

# Feed options: public, wea, eas, nwem, public_non_eas
IPAWS_FEED=public

# FEMA recommends polling no more frequently than every 2 minutes.
# Set this wider than your cron interval so brief downtime does not miss alerts.
IPAWS_LOOKBACK_MINUTES=10
IPAWS_REQUEST_TIMEOUT_SECONDS=20
IPAWS_VERIFY_TLS=true

# Optional path to a CA bundle if your Python runtime cannot validate FEMA TLS.
# Leave blank for the default system/Python trust store.
IPAWS_CA_BUNDLE=

# Local de-duplication state. Use an absolute path for cron/systemd.
IPAWS_STATE_FILE=ipaws_state.json
IPAWS_SENT_CACHE_SIZE=200
IPAWS_MAX_ALERTS_PER_RUN=3

# Optional filters. Leave blank to relay all active alerts from the selected feed.
# SAME examples: 004013 for Maricopa County, AZ; 004000 for all Arizona.
IPAWS_FILTER_SAME_CODES=
IPAWS_FILTER_UGC_CODES=
IPAWS_FILTER_STATES=
IPAWS_FILTER_EVENT_CODES=
IPAWS_FILTER_SEVERITIES=
IPAWS_LANGUAGE=en
IPAWS_MESSAGE_PREFIX=IPAWS

# Meshtastic connection configuration
# Connection type: serial or tcp
MESHTASTIC_CONNECTION_TYPE=serial

# Linux examples: /dev/ttyUSB0, /dev/ttyACM0
MESHTASTIC_SERIAL_PORT=/dev/ttyUSB0

# TCP example: 192.168.1.100
MESHTASTIC_TCP_HOST=192.168.1.100

# Channel index, where 0 is Primary.
MESHTASTIC_CHANNEL=0
MESHTASTIC_MAX_MESSAGE_LENGTH=200
MESHTASTIC_SEND_DELAY_SECONDS=2

# Set false for dry-run testing without transmitting.
MESHTASTIC_SEND_ENABLED=false

LOG_LEVEL=INFO
